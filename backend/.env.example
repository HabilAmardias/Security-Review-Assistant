# Infrastructure configuration (environment variables, ASE_ prefix).
# Copy to `.env` and adjust. Business-logic settings (models, temperature,
# max_tokens, num_ctx, thinking, chunking, extraction) are configured in the UI.

ASE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Request timeout in seconds. Leave unset to disable the timeout entirely
# (recommended for slow local models on first load / long reviews).
# ASE_REQUEST_TIMEOUT_SEC=300

ASE_DATA_DIR=data
ASE_HOST=127.0.0.1
ASE_PORT=8000
ASE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ASE_ASYNCIO_DEBUG=false
ASE_LOG_LEVEL=INFO
